*.pyc
.DS_Store
.venv/

# Ignore sensitive variable stores
.config/fish/fish_variables

# Fish auto-generated completions — regenerated by each tool's own
# `… completion fish`, so they are machine state, not config.
.config/fish/completions/

# Fish auto-generated migration artifacts (fish recommends deleting these)
.config/fish/conf.d/fish_frozen_key_bindings.fish
.config/fish/conf.d/fish_frozen_theme.fish

# Editor swap/backup files
*.swp
*.swo
*~
